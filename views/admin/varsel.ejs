<%- include('partials/admin-topp', { tittel: 'Varsellinje', aktiv: 'varsel' }) %>

<p class="a-ingress">Varsellinja blir vist øvst på alle sider – nyttig ved ferie, kampanjar eller driftsmeldingar. Legg du inn ei lenkje, blir heile linja klikkbar.</p>

<section class="a-seksjon">
  <form method="post" action="/admin/varsel">
    <label class="a-slett"><input type="checkbox" name="aktiv" <%= c.varsel.aktiv ? 'checked' : '' %>> Vis varsellinja</label>
    <label for="tekst">Tekst</label>
    <input id="tekst" name="tekst" value="<%= c.varsel.tekst %>" maxlength="140" placeholder="T.d. «Vi har feriestengt veke 28–30 – god sommar!»">
    <label for="lenkje">Lenkje (valfritt)</label>
    <input id="lenkje" name="lenkje" value="<%= c.varsel.lenkje %>" placeholder="T.d. /kontakt">
    <button class="a-knapp" type="submit">Lagre varsellinje</button>
  </form>
</section>

<% if (c.varsel.aktiv && c.varsel.tekst) { %>
<p>Slik ser ho ut no: <a href="/" target="_blank" rel="noopener">opne nettsida ↗</a></p>
<% } %>

<%- include('partials/admin-botn') %>
